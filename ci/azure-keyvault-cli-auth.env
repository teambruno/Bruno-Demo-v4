# Passed to the CLI as `bru run --secrets-env-file ci/azure-keyvault-cli-auth.env`.
#
#   https://docs.usebruno.com/bru-cli/secret-managers#azure-cli-auth
#
# This file is committed on purpose: there is no credential in it. The single
# line below tells Bruno to authenticate to Azure Key Vault with whatever
# `az login` session already exists - on a laptop that is your own `az login`,
# on a GitHub runner it is the short-lived OIDC token `azure/login` fetched.
#
# The trade-off vs. the service-principal file next to this one: this needs the
# Azure CLI on the machine, but never a client secret anywhere.
BRUNO_AZURE_AUTH_METHOD=cli
