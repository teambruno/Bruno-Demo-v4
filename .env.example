# =============================================================================
# .env.example — TEMPLATE / REFERENCE ONLY. This file IS committed to git.
# =============================================================================
#
# First time setting up this workspace?
#
#   1. Copy this file:   cp .env.example .env
#   2. Replace the placeholder values below with your own real credentials.
#   3. Never commit .env — it is already listed in .gitignore.
#
# Every value in THIS file is fake/dummy. Nothing here works against a live
# service, and no real secret should ever be added here — anything in this file
# is visible to everyone with repo access.
#
# How these get used:
#   Bruno reads .env and exposes each key as {{process.env.NAME}} in
#   environments, collections, and requests.
#   e.g. environments/Globals-Local.yml uses {{process.env.apikey}}
#
#   App vs CLI - they look in different places:
#     App  reads this file at the workspace root.
#     CLI  reads .env from the COLLECTION root (its working directory), so a
#          workspace-root .env alone is not picked up by `bru run`.
#
#   Verified with bru 3.3.0. To make a collection see it, symlink once:
#     ln -s ../../.env "collections/03 - Secrets and OpenAPI/.env"
#   The symlink is covered by the .env rule in .gitignore, so it stays local.
#
#   Real OS environment variables also resolve via {{process.env.NAME}} -
#   that is how CI supplies BRUNO_GLOBAL_API_KEY without any .env at all.
#
# If you add a new variable to your local .env, add it here too with a
# placeholder value so the next person knows it is required.
# =============================================================================


# -- In use by this workspace -------------------------------------------------
# Referenced by environments/Globals-CI.yml and environments/Globals-Local.yml
BRUNO_GLOBAL_API_KEY=brn_test_7f3c1a9e42b84d6f8ac05e1b93d7f204
apikey=ak_demo_5b1d8c04f39e47aab6720fd3c8e15a9b


# -- OAuth2 -------------------------------------------------------------------
# Client-credentials flow used by the auth examples.
OAUTH_CLIENT_ID=bruno-demo-client
OAUTH_CLIENT_SECRET=cs_stg_QF8mVz2LnR6xTb4KpW9dHeYs
OAUTH_TOKEN_URL=https://www.httpfaker.org/oauth2/token
# Quoted deliberately: the value contains a space, and an unquoted
# `OAUTH_SCOPE=read write` executes `write` if anyone `source`s this file.
OAUTH_SCOPE="read write"


# -- Basic / bearer auth ------------------------------------------------------
BRUNO_DEMO_USERNAME=jamesd
BRUNO_DEMO_PASSWORD=Tr0ub4dor-Horse-Battery
BRUNO_BEARER_TOKEN=brn_bearer_2f8c14ae7b9d43f6


# -- Base URLs ----------------------------------------------------------------
# Point these at your own environments. LOCAL_BASE_URL assumes a service
# listening on port 3000 on your machine.
LOCAL_BASE_URL=http://localhost:3000
STAGING_BASE_URL=https://staging.ourapi.net
IDENTITY_BASE_URL=https://bruno-demo.login.net


# -- Third-party --------------------------------------------------------------
# Supply your own test-mode keys. Test/sandbox credentials only — never
# production keys, even in your local .env.
STRIPE_TEST_KEY=sk_test_51NxAbCdEfGhIjKlMnOpQrStUvWxYz0123456789
# Deliberately unrealistic. A `ghp_` prefix followed by 36 alphanumerics
# matches GitHub's PAT pattern, so secret-scanning push protection blocks the
# push even when the value is fake. Underscores keep this one out of the match.
GITHUB_TOKEN=ghp_your_personal_access_token_here
WEBHOOK_SIGNING_SECRET=whsec_9c2f7ab3e14d5680bf3a1e2c4d8b60f7
